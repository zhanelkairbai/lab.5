<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Проверка возраста</title>
</head>
<body>

    <h1>Проверка возраста</h1>

    <input type="number" id="age" placeholder="Введите возраст">
    <button onclick="checkAge()">Проверить</button>

    <p id="result"></p>

    <script>
        function checkAge() {
            const age = Number(document.getElementById("age").value);
            const result = document.getElementById("result");

            if (age < 0) {
                result.textContent = "Введите корректный возраст.";
            } else if (age < 13) {
                result.textContent = "Вы ребенок.";
            } else if (age < 18) {
                result.textContent = "Вы подросток.";
            } else {
                result.textContent = "Вы взрослый.";
            }
        }
    </script>

</body>
</html>
